# [[ project_name ]] ortam değişkenleri. Kopyalayın: cp .env.example .env
# (`make setup` bunu sizin için yapar ve rastgele SECRET_KEY üretir.)

# --- Çekirdek -------------------------------------------------------------
DEBUG=False
SECRET_KEY=
# Canlıda zorunlu: virgülle ayrılmış alan adları
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Yönetim paneli adresini tahmin edilmesi zor yapın (sonunda / olmalı)
ADMIN_URL=admin/
# Caddy/Nginx arkasındaysanız True (istemci IP'si rate limit için X-Forwarded-For'dan okunur)
TRUST_X_FORWARDED_FOR=False
LOG_LEVEL=INFO
# Arayüz dilleri (ilk dil kök adreste): [[ languages ]]
# LANGUAGES=[[ languages ]]

# --- Veritabanı -----------------------------------------------------------
# Boş bırakılırsa ./db.sqlite3 kullanılır.
[%- if database == 'postgres' %]
# DATABASE_URL=postgres://app:sifre@localhost:5432/[[ project_slug ]]
# Docker compose için zorunlu (db servisinin parolası; DATABASE_URL'i compose kendisi kurar)
POSTGRES_PASSWORD=
# POSTGRES_USER=app
# POSTGRES_DB=app
[%- else %]
# DATABASE_URL=sqlite:////data/db.sqlite3
[%- endif %]

# --- E-posta (console | smtp | resend) ------------------------------------
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=[[ project_name ]] <noreply@[[ domain ]]>
NOTIFICATION_EMAILS=[[ author_email ]]
# Canlıdaki 500 hataları bu adreslere e-postayla bildirilir
ADMINS=[[ author_email ]]
# RESEND_API_KEY=
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Güvenlik (yalnızca DEBUG=False iken) ---------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
[%- if use_maps %]

# --- Harita (apps.places) -------------------------------------------------
# stadia | carto | pmtiles  (lisans ve fiyat notları README'de)
MAP_TILES=[[ map_tiles ]]
# STADIA_API_KEY=
# CARTO_API_KEY=            # ücretsiz: https://carto.com/basemaps/apikey
# PMTILES_URL=https://harita.[[ domain ]]/turkiye.pmtiles
MAP_CENTER_LAT=41.0082
MAP_CENTER_LNG=28.9784
PLACES_SYNC_RADIUS_KM=5
# OSM sunucuları gerçek bir iletişim adresi ister (e-posta veya site URL'si)
OVERPASS_USER_AGENT=[[ project_slug ]]/1.0 ([[ author_email ]])
[%- endif %]
[%- if use_llm %]

# --- LLM (apps.ai) ----------------------------------------------------------
LLM_PROVIDER=[[ llm_provider ]]
LLM_API_KEY=
[%- if llm_provider == 'anthropic' %]
LLM_BASE_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-opus-5
[%- else %]
# OpenRouter / DeepSeek / Groq / Gemini (OpenAI uyumlu uç) / Ollama...
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=
# Model destekliyorsa açın:
LLM_OPENAI_REASONING=False
LLM_OPENAI_JSON_MODE=none
[%- endif %]
LLM_EFFORT=low
LLM_MAX_TOKENS=16000
[%- endif %]
[%- if use_news %]

# --- Haberler (apps.news) --------------------------------------------------
# Kaynak sitelere kim olduğunuzu söyleyin (gerçek iletişim adresi)
NEWS_USER_AGENT=[[ project_slug ]]-news/1.0 ([[ author_email ]])
NEWS_SYNC_LIMIT=10
NEWS_ENRICH=True
# AI özetlerinin dili (boşsa sitenin kök dili)
# NEWS_SUMMARY_LANGUAGE=tr
NEWS_SHOW_REMOTE_IMAGES=False
[%- endif %]
